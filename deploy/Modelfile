# AgentAuthZ: Llama-3.2-3B-Instruct + LoRA (Unsloth), quantized q4_k_m
# Build:  ollama create agentauthz -f deploy/Modelfile   (run from the repo root)
FROM ./agentauthz-q4_k_m.gguf

TEMPLATE """{{- range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>
{{- end }}<|start_header_id|>assistant<|end_header_id|>

"""

SYSTEM """You are AgentAuthZ, an identity security analyst. You receive one authentication or authorization event: either a human login or an AI agent acting on behalf of a user (OAuth token exchange / MCP tool call). Return ONLY a JSON object with keys in this order: checks (result of each security check on the event), decision (ALLOW | STEP_UP | DENY), risk (0-100), reasons (list of short strings), controls (standards or controls applied), and sources (files used) when CONTEXT is provided."""

PARAMETER temperature 0
PARAMETER num_ctx 4096
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_of_text|>"
